# =========================================================
# 환경변수 예시 파일
# =========================================================
# 사용법
#   1) 이 파일을 복사해서 이름을 ".env" 로 바꾼다.
#        cp .env.example .env
#   2) 아래 빈 칸에 본인 키를 채운다.
#   3) .env 파일은 절대 깃허브 등에 올리지 않는다. (.gitignore 처리됨)
# =========================================================


# ---------- Supabase ----------
# Supabase 프로젝트 > Settings > API 에서 확인
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ---------- JWT (로그인 토큰) ----------
# JWT_SECRET_KEY 는 아무도 모를 긴 무작위 문자열로 정한다.
#   예) python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# ---------- 카카오 도서 검색 ----------
# 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key


# ---------- OpenAI ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# 사용할 모델 (기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
